{
    "name": "laravel/ecomm-demo-ls",
    "type": "project",
    "description": "Custom printing ecommerce website",
    "require": {
        "php": "^8.2",
        "laravel/framework": "^10.48"
    },
    "require-dev": {
        "fakerphp/faker": "^1.9",
        "laravel/pint": "^1.0",
        "mockery/mockery": "^1.6",
        "nunomaduro/collision": "^8.0",
        "phpunit/phpunit": "^10.5"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "config": {
        "policy": {
            "advisories": {
                "block": false
            }
        }
    },
    "scripts": {
        "post-autoload-dump": [
            "Illuminate\\Foundation\\ComposerScripts::postAutoloadDump"
        ]
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}